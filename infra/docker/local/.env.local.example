# 로컬 개발 env 템플릿입니다. 복사한 .env.local은 git에 올리지 않습니다(.gitignore).
#   cp infra/docker/local/.env.local.example infra/docker/local/.env.local
# 이 파일은 두 곳에서 읽습니다.
#   1) local compose 컨테이너의 env_file(MySQL, PostgreSQL, Redis, kafka-init, API, Core)
#   2) IDE에서 띄운 API Server의 local 프로필(spring.config.import로 properties 형식으로 읽음)
# 그래서 KEY=VALUE 한 줄 형식만 쓰고 따옴표는 붙이지 않습니다.
# 비밀번호는 로컬 전용 값으로 새로 정합니다(예: openssl rand -hex 16). 운영 값을 재사용하지 않습니다.

# ── MySQL(API DB) ────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
# local compose의 API는 DB 이름 theseus로 접속합니다.
MYSQL_DATABASE=theseus
MYSQL_USER=theseus
MYSQL_PASSWORD=
# IDE에서 띄운 API가 쓰는 접속 정보입니다. 비밀번호는 MYSQL_PASSWORD와 같은 값을 넣습니다.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:13306/theseus
SPRING_DATASOURCE_USERNAME=theseus
SPRING_DATASOURCE_PASSWORD=

# ── PostgreSQL + pgvector(Core DB) ───────────────────────────────────────────
# Core 컨테이너는 POSTGRES_*를 CORE_POSTGRES_* 별칭으로 읽습니다.
POSTGRES_USER=theseus
POSTGRES_PASSWORD=
POSTGRES_DB=theseus_core

# ── Redis ────────────────────────────────────────────────────────────────────
# Redis 컨테이너의 requirepass로도 이 값을 씁니다. 비어 있으면 Redis가 기동하지 않습니다.
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=16379

# ── Kafka ────────────────────────────────────────────────────────────────────
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
# 토픽 이름은 코드 기본값과 같습니다. 바꾸면 API, Core, kafka-init이 함께 따라갑니다.
KAFKA_TOPIC_TOOL_PLAN_REQUEST=theseus.tool-plan.request
KAFKA_TOPIC_TOOL_PLAN_EVENT=theseus.tool-plan.event
KAFKA_TOPIC_TOOL_BUILD_REQUEST=theseus.tool-build.request
KAFKA_TOPIC_TOOL_BUILD_EVENT=theseus.tool-build.event

# ── API <-> Core 공통 ────────────────────────────────────────────────────────
# JWT HMAC 키. 32바이트 이상(예: openssl rand -base64 48).
JWT_SECRET=
# API와 Core가 같은 값을 써야 합니다(예: openssl rand -hex 32).
INTERNAL_API_KEY=
THESEUS_CORE_BASE_URL=http://localhost:8086
# 주석으로 두면 local 프로필 기본값(http://localhost:5173,http://localhost:3000)을 씁니다.
# 빈 값으로 두면 Spring이 빈 문자열을 그대로 써서 CORS가 꺼지므로, 바꿀 때만 주석을 풉니다.
# ALLOWED_ORIGINS=http://localhost:5173

# 최초 관리자(SUPER_ADMIN이 없을 때 한 번만 생성). 로컬 전용 값을 씁니다.
INITIAL_ADMIN_EMPLOYEE_NUMBER=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ── Core LLM(Core를 local compose로 띄울 때) ─────────────────────────────────
# provider 접두사가 붙은 모델(ollama/<모델>, anthropic/<모델>, openai/gpt-*, gemini/..., deepseek/...).
THESEUS_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
