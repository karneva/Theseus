# Theseus 셀프호스팅(docker-compose.yml) env 템플릿입니다.
# 서버에서 저장소 밖에 복사해 씁니다. 비밀값이 들어가므로 권한을 600으로 둡니다.
#   cp infra/docker/selfhost/.env.example /opt/theseus/theseus.env
#   chmod 600 /opt/theseus/theseus.env
#   scripts/gen-secrets.sh --fill /opt/theseus/theseus.env   # 빈 비밀값을 새 값으로 채웁니다
# compose는 이 파일을 --env-file로만 읽고(변수 치환), 각 컨테이너에는 compose가 필요한 변수만 골라 넘깁니다.
# 값이 비어 있는 필수 항목이 있으면 docker compose config/up이 어떤 변수가 빠졌는지 알려 주고 멈춥니다.
# compose는 따옴표 없는 값의 '$'를 변수로 치환합니다(Ab$cd9!x -> Ab!x). '$'가 들어간 값은 작은따옴표로
# 감싸거나('Ab$cd9!x') '$$'로 씁니다. gen-secrets.sh가 만드는 값에는 '$'가 없습니다.

# ── 공통 ─────────────────────────────────────────────────────────────────────
# 서비스 도메인(예: theseus.example.com). nginx server_name과 인증서 경로에 쓰입니다. 필수.
DOMAIN=
# Let's Encrypt 만료 알림을 받을 메일 주소(scripts/issue-cert.sh). 필수.
CERTBOT_EMAIL=
TZ=Asia/Seoul
# 호스트 bind 디렉터리 루트입니다. sandbox-tmp, custom-tools, core-data, ssh-keys, backups가 이 아래에 있습니다.
THESEUS_HOST_ROOT=/opt/theseus

# ── 이미지 ───────────────────────────────────────────────────────────────────
# scripts/build-images.sh가 출력한 태그를 넣습니다. 필수.
IMAGE_TAG=
# 레지스트리를 쓸 때만 끝에 '/'를 붙여 지정합니다(예: registry.example.com/theseus/). 비우면 로컬 이미지 이름 그대로 씁니다.
IMAGE_REGISTRY=
SANDBOX_IMAGE=theseus-sandbox:py311-tools
# ── 자동 배포(GitHub Actions, scripts/ci-deploy.sh). 수동 배포만 하면 비워 둡니다 ───────────────
# 이미지를 받을 레지스트리(끝에 '/'). 받은 이미지는 로컬 이름(theseus-*:<태그>)으로 retag하므로 IMAGE_REGISTRY는 비워 둡니다.
# 예: ghcr.io/<owner>/
DEPLOY_PULL_REGISTRY=
# 배포 설정(compose, scripts)을 가져올 저장소(https). 서버가 직접 fetch하고 dev에 포함된 커밋만 배포합니다.
# 예: https://github.com/<owner>/<repo>.git
DEPLOY_GIT_URL=
# 자동 배포 후 구성 요소별로 남겨 둘 최근 이미지 태그 수(현재·직전 태그는 항상 남김).
DEPLOY_KEEP_TAGS=3

# ── 비밀값(scripts/gen-secrets.sh로 생성) ───────────────────────────────────
# JWT HMAC 키. 32바이트 이상이어야 합니다.
JWT_SECRET=
# API <-> Core 서버 간 공유 키.
INTERNAL_API_KEY=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# KRaft 클러스터 ID(base64url 22자). 한 번 정하면 kafka-data 볼륨을 지우기 전까지 바꾸지 않습니다.
KAFKA_CLUSTER_ID=

# ── 데이터베이스 ─────────────────────────────────────────────────────────────
MYSQL_DATABASE=theseus
MYSQL_USER=theseus
POSTGRES_DB=theseus_core
POSTGRES_USER=theseus

# ── API ──────────────────────────────────────────────────────────────────────
# nginx same-origin 배포에서는 비워 둡니다(CORS off). 다른 origin에서 호출할 때만 쉼표로 나열합니다.
ALLOWED_ORIGINS=
# 도메인 없이 HTTP로만 시험할 때만 false로 바꿉니다.
JWT_REFRESH_TOKEN_COOKIE_SECURE=true
# 최초 관리자(SUPER_ADMIN이 없을 때 한 번만 생성). 강한 비밀번호를 쓰고, 로그인 확인 후 PASSWORD 값을 지웁니다.
# 비밀번호에 '$'가 있으면 반드시 작은따옴표로 감쌉니다(INITIAL_ADMIN_PASSWORD='...'). 감싸지 않으면 다른 값으로
# 계정이 만들어지고, SUPER_ADMIN이 생긴 뒤에는 다시 만들어지지 않습니다.
INITIAL_ADMIN_EMPLOYEE_NUMBER=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# JVM 옵션을 바꿀 때만 주석을 풉니다. 기본값은 compose에 있습니다(-Xmx384m, SerialGC).
# JAVA_TOOL_OPTIONS=-Xms192m -Xmx384m -Xss512k -XX:MaxMetaspaceSize=160m -XX:ReservedCodeCacheSize=64m -XX:MaxDirectMemorySize=64m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError

# ── Core / LLM ───────────────────────────────────────────────────────────────
# provider 접두사가 붙은 모델 이름. 노트북 Ollama 모델이면 ollama/<모델명>. 필수.
THESEUS_MODEL=
# 노트북 Ollama가 reverse SSH tunnel(scripts/llm-tunnel.sh)로 호스트에 열리는 주소입니다.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# 외부 provider를 쓸 때만 해당 키를 채웁니다.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
THESEUS_LLM_TIMEOUT_SECONDS=300
# 작은 로컬 모델은 컨텍스트가 짧으므로 출력 토큰 상한을 낮춥니다(예: 4096).
LLM_MAX_OUTPUT_TOKENS=32768
CORE_TOOL_PLAN_CONSUMER_ENABLED=true
CORE_TOOL_BUILD_CONSUMER_ENABLED=true

# ── Sandbox / Remote Workspace ───────────────────────────────────────────────
# true면 sandbox 이미지가 없을 때 Core가 기동을 거부합니다.
SANDBOX_STARTUP_STRICT=true
SANDBOX_MEMORY_LIMIT=128m
# Remote Workspace SSH 키 디렉터리(선택). 파일은 uid 999가 읽을 수 있어야 합니다(chown 999:999, chmod 600).
# 비워 두면 <THESEUS_HOST_ROOT>/ssh-keys(server-bootstrap.sh가 만드는 디렉터리)를 씁니다.
REMOTE_WORKSPACE_KEYS_DIR=

# ── Kafka ────────────────────────────────────────────────────────────────────
# 비워 두면 코드 기본값(theseus.tool-plan.request 등)을 씁니다. 바꾸면 API와 Core가 함께 따라갑니다.
KAFKA_TOPIC_TOOL_PLAN_REQUEST=
KAFKA_TOPIC_TOOL_PLAN_EVENT=
KAFKA_TOPIC_TOOL_BUILD_REQUEST=
KAFKA_TOPIC_TOOL_BUILD_EVENT=
KAFKA_TOPIC_PARTITIONS=3

# ── nginx ────────────────────────────────────────────────────────────────────
# auto: 인증서가 있으면 HTTPS, 없으면 HTTP. http/https로 강제할 수 있습니다.
NGINX_TLS_MODE=auto
# HTTPS가 안정적으로 동작하는 것을 확인하기 전에는 300 같은 작은 값으로 시작해도 됩니다.
HSTS_MAX_AGE=31536000
