# HTTP 전용 템플릿입니다. 인증서가 아직 없을 때(최초 ACME 발급 전) 자동으로 선택됩니다.
# - /.well-known/acme-challenge/로 certbot webroot 인증을 받습니다.
# - 도메인 없이 IP로 먼저 띄워 보는 경우를 위해 앱도 HTTP로 서빙합니다.
#   prod 프로필은 refresh 쿠키에 Secure를 붙이므로 HTTP에서는 access 토큰 만료(기본 1시간) 후 다시 로그인해야 합니다.
# ${DOMAIN}만 envsubst로 치환되고 나머지 $변수는 nginx 변수입니다(NGINX_ENVSUBST_FILTER).

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${DOMAIN};

    include /etc/nginx/snippets/security-headers.conf;

    set $theseus_api http://api:8080;
    set $theseus_frontend http://frontend:80;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    # 컨테이너 healthcheck용입니다. 상태 문자열만 반환합니다.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    include /etc/nginx/snippets/app-locations.conf;
}
