#!/bin/sh
# nginx 공식 이미지 entrypoint가 source하는 스크립트입니다(.envsh). 20-envsubst-on-templates.sh보다 먼저 실행됩니다.
# 인증서 존재 여부로 HTTP/HTTPS 템플릿 디렉터리를 골라 NGINX_ENVSUBST_TEMPLATE_DIR로 넘깁니다.
#   NGINX_TLS_MODE=auto  : /etc/letsencrypt/live/$DOMAIN/{fullchain,privkey}.pem이 있으면 https, 없으면 http
#   NGINX_TLS_MODE=http  : 항상 HTTP 템플릿(인증서 문제를 임시로 우회할 때)
#   NGINX_TLS_MODE=https : 항상 HTTPS 템플릿(인증서가 없으면 nginx 기동이 실패합니다)
# 인증서를 처음 발급한 뒤에는 컨테이너를 재시작해야 이 선택이 다시 일어납니다(scripts/issue-cert.sh가 처리).

theseus_tls_mode="${NGINX_TLS_MODE:-auto}"
theseus_cert_dir="/etc/letsencrypt/live/${DOMAIN}"

case "$theseus_tls_mode" in
    http|https) ;;
    *)
        if [ -n "${DOMAIN}" ] && [ -s "${theseus_cert_dir}/fullchain.pem" ] && [ -s "${theseus_cert_dir}/privkey.pem" ]; then
            theseus_tls_mode=https
        else
            theseus_tls_mode=http
        fi
        ;;
esac

export NGINX_ENVSUBST_TEMPLATE_DIR="/etc/nginx/theseus-templates/${theseus_tls_mode}"
echo "18-theseus-tls-mode: DOMAIN=${DOMAIN:-<unset>} TLS mode=${theseus_tls_mode}"
unset theseus_tls_mode theseus_cert_dir
