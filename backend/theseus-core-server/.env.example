# =======================================================
# Theseus Core Server 환경변수 예시
# 이 파일을 .env로 복사해 로컬 실행(uvicorn)에 씁니다. Docker 배포에서는
# compose가 같은 이름의 변수를 주입합니다. 비밀값은 절대 커밋하지 마세요.
# =======================================================


# =======================================================
# 1. Model & Routing
# =======================================================
# THESEUS_MODEL은 provider 접두사를 붙여 지정합니다. 접두사가 있으면 그 provider로
# 확정 라우팅하고, 없을 때만 모델명으로 provider를 추정합니다.
#   - Ollama    : "ollama/llama3.1", "ollama/deepseek-r1"  → OLLAMA_BASE_URL
#   - vLLM      : "vllm/<served-model-id>" 또는 "vllm"      → OPENAI_BASE_URL
#   - Anthropic : "anthropic/<model-id>" 또는 claude 계열 모델 id
#   - OpenAI    : "openai/<model-id>" 또는 gpt-* 계열 모델 id
#   - Gemini    : "gemini/<model-id>"
#   - DeepSeek  : "deepseek/<model-id>"
# ENV=prod에서는 필수입니다(비어 있으면 기동 실패). local에서 비우면 개발용 기본값을 씁니다.
THESEUS_MODEL=

# Smart Model Routing: true면 최근 도구 호출에 따라 FAST/REASONING 모델을 고릅니다.
THESEUS_MODEL_ROUTING=false
# 비워 두면 THESEUS_MODEL을 씁니다.
# THESEUS_MODEL_FAST=
# THESEUS_MODEL_REASONING=

# 자체 호스팅 / OpenAI 호환 엔드포인트
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENAI_BASE_URL=http://localhost:8000/v1
# vLLM 사용 시 /v1/models에서 served model을 자동 탐색합니다.
# THESEUS_VLLM_AUTO_DISCOVER_MODEL=true
# THESEUS_VLLM_MODEL=
# 클라우드 provider endpoint override(보통 비워 둡니다)
# GEMINI_BASE_URL=
# DEEPSEEK_BASE_URL=
# OpenAI 호환 클라이언트 timeout(초)과 엔진 재시도 횟수
# THESEUS_LLM_TIMEOUT_SECONDS=120
# THESEUS_LLM_MAX_RETRIES=3

# LLM 호출 한도. 컨텍스트가 작은 로컬 모델이면 LLM_MAX_OUTPUT_TOKENS를 낮추세요.
LLM_MAX_OUTPUT_TOKENS=32768
CORE_STREAM_MAX_AGENT_TURNS=30


# =======================================================
# 2. API Keys (사용하는 provider의 키만 입력)
# =======================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=


# =======================================================
# 3. App & Environment
# =======================================================
# ENV: local | prod
ENV=local
PORT=8086
# Core는 브라우저가 직접 호출하지 않습니다(API Server가 프록시). 비워 두면 local에서는
# 개발 서버 origin을 허용하고, prod에서는 CORS를 끕니다. '*'는 prod에서 거부됩니다.
ALLOWED_ORIGINS=


# =======================================================
# 4. API Server 연동 / 인증
# =======================================================
# AUTH_MODE: spring | mock (mock은 local/dev/test에서만 허용)
AUTH_MODE=spring
# API Server base URL. 내부 API 경로(/api/internal/...)는 코드에서 조합합니다.
# 예: compose 내부망이면 http://api:8080
SPRING_BOOT_INTERNAL_URL=http://localhost:8080
# 특수한 배포에서만 개별 URL을 override합니다(보통 비워 둡니다).
# SPRING_BOOT_AUTH_VERIFY_URL=
# SPRING_BOOT_PROJECT_PERMISSIONS_URL=
# SPRING_BOOT_BILLING_USAGE_URL=
# SPRING_BOOT_INTERNAL_HISTORY_MESSAGES_URL=
# SPRING_BOOT_REMOTE_WORKSPACE_CONFIG_URL=
# API Server와 같은 값을 씁니다. 예: openssl rand -hex 32
# (기존 이름 SPRING_BOOT_INTERNAL_API_KEY도 하위호환으로 읽습니다.)
INTERNAL_API_KEY=
AUTH_TIMEOUT_SECONDS=5
INTERNAL_API_TIMEOUT_SECONDS=10
BILLING_OUTBOX_SCHEDULER_ENABLED=false
BILLING_OUTBOX_BATCH_SIZE=10
BILLING_OUTBOX_FLUSH_INTERVAL_SECONDS=30


# =======================================================
# 5. Kafka (PLAN / BUILD)
# =======================================================
CORE_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
CORE_TOOL_PLAN_CONSUMER_ENABLED=true
CORE_TOOL_BUILD_CONSUMER_ENABLED=true
# 모든 consumer를 한 번에 끄는 master 스위치(기본 true).
# CORE_KAFKA_CONSUMER_ENABLED=true
CORE_KAFKA_TOOL_PLAN_CONSUMER_GROUP_ID=theseus-core-tool-plan
CORE_KAFKA_TOOL_BUILD_CONSUMER_GROUP_ID=theseus-core-tool-build
KAFKA_TOPIC_TOOL_PLAN_REQUEST=theseus.tool-plan.request
KAFKA_TOPIC_TOOL_PLAN_EVENT=theseus.tool-plan.event
KAFKA_TOPIC_TOOL_BUILD_REQUEST=theseus.tool-build.request
KAFKA_TOPIC_TOOL_BUILD_EVENT=theseus.tool-build.event

# PLAN draft execution spec validation mode: strict | warn | off (운영은 strict 권장)
CORE_TOOL_PLAN_EXECUTION_SPEC_VALIDATION_MODE=strict
# PLAN draft final JSON synthesis mode:
# auto | response_format | vllm_structured_outputs | strict | off
CORE_TOOL_PLAN_STRUCTURED_OUTPUT_MODE=auto
CORE_TOOL_PLAN_MAX_AGENT_TURNS=30
# Assistant가 작업을 예고만 하고 tool call 없이 멈춘 경우 자동 재진입하는 최대 횟수
THESEUS_AGENT_AUTO_CONTINUE_MAX=1
# Agent loop 재진입 판정 모드: heuristic | semantic | hybrid
THESEUS_AGENT_LOOP_DECISION_MODE=hybrid
THESEUS_AGENT_LOOP_SEMANTIC_TIMEOUT_SECONDS=4
# Engine 공통 custom tool repair loop 횟수 (CLI/TUI/Extension/Server 공통)
THESEUS_TOOL_REPAIR_MAX_ATTEMPTS=2
# Server ToolBuild 호환 alias. 새 로직은 THESEUS_TOOL_REPAIR_MAX_ATTEMPTS를 우선 사용합니다.
CORE_TOOL_BUILD_MAX_REPAIR_ATTEMPTS=2
CORE_TOOL_BUILD_RUN_TIMEOUT_SECONDS=180
CORE_RUN_LEASE_TTL_SECONDS=60
CORE_RUN_EVENT_REPUBLISH_BATCH_SIZE=50


# =======================================================
# 6. Sandbox / Docker
# =======================================================
# 생성 Tool 검증용 sandbox 이미지. Core는 이 이미지를 자동 빌드하지 않습니다.
#   docker build -f Dockerfile.sandbox -t theseus-sandbox:py311-tools .
SANDBOX_IMAGE=theseus-sandbox:py311-tools
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_CPU_QUOTA=50000
SANDBOX_CPU_PERIOD=100000
SANDBOX_KEEP_FAILED_CONTAINERS=false
SANDBOX_STARTUP_CHECK=true
SANDBOX_STARTUP_STRICT=false
SANDBOX_PULL_ON_STARTUP=false
# 비워 두면 docker SDK 기본값(로컬 소켓)을 씁니다.
# DOCKER_HOST=unix:///var/run/docker.sock
# Core 컨테이너가 host Docker daemon을 제어할 때는 두 경로가 같은 bind mount를 가리켜야 합니다.
# host Python 실행에서는 비워 두면 OS 임시 디렉터리를 씁니다.
# 호스트 경로는 Core 컨테이너 사용자(uid 999)가 쓸 수 있어야 합니다. sandbox 컨테이너는
# uid 65534, cap_drop=ALL, read-only rootfs, pids/메모리 제한으로 실행됩니다.
# SANDBOX_HOST_TEMP_ROOT=/tmp/theseus-sandbox-shared
# SANDBOX_CONTAINER_TEMP_ROOT=/tmp/theseus-sandbox-shared


# =======================================================
# 7. Data / Custom Tools / Cache
# =======================================================
# 에이전트 런타임 데이터 경로. 기본값 ~/.theseus/data (Docker: /home/appuser/.theseus/data)
# THESEUS_DATA_DIR=
# 생성 Tool 저장 경로. prod Docker에서는 THESEUS_CUSTOM_TOOLS_HOST_DIR(호스트 경로)를
# THESEUS_PROJECT_CUSTOM_TOOLS_DIR(컨테이너 경로)에 bind mount합니다.
# THESEUS_CUSTOM_TOOLS_DIR=
# THESEUS_PROJECT_CUSTOM_TOOLS_DIR=
# THESEUS_CUSTOM_TOOLS_HOST_DIR=
# 임베딩 모델(sentence-transformers) 캐시. Docker 기본값 /home/appuser/.cache/huggingface
# HF_HOME=


# =======================================================
# 8. Database (PostgreSQL + pgvector)
# =======================================================
CORE_POSTGRES_HOST=localhost
CORE_POSTGRES_PORT=15432
CORE_POSTGRES_DB=theseus_core
CORE_POSTGRES_USER=
CORE_POSTGRES_PASSWORD=
# public이 아니면 search_path=<schema>,public으로 접속합니다.
CORE_POSTGRES_SCHEMA=public
CORE_POSTGRES_POOL_SIZE=5
CORE_POSTGRES_MAX_OVERFLOW=10

# RAG & Embeddings: EMBEDDING_PROVIDER local(sentence-transformers) | remote(openai)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DIMENSION=384
RAG_TOP_K=5
RAG_MIN_SCORE=0.3


# =======================================================
# 9. Observability (LangSmith, 기본 비활성)
# =======================================================
# 세 값이 모두 맞아야 활성화됩니다: THESEUS_TRACING_ENABLED=true, LANGCHAIN_API_KEY 설정,
# LANGCHAIN_TRACING_V2가 false가 아님. 대화 내용이 외부로 전송되므로 명시적으로 켤 때만 쓰세요.
THESEUS_TRACING_ENABLED=false
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=theseus-core


# =======================================================
# 10. Theseus Engine
# =======================================================
# THESEUS_RUNTIME_MODE: standalone | server. 미설정 시 project_id + actor_user_id로 자동 감지
# THESEUS_RUNTIME_MODE=

# THESEUS_DYNAMIC_TOOL_RETRIEVAL: true (RAG 기반 도구 선택) | false (전체 레지스트리 사용)
THESEUS_DYNAMIC_TOOL_RETRIEVAL=false

# THESEUS_ENABLE_AGENT_HOOK: true (파일 작업 보안 감사 훅 활성화) | false
THESEUS_ENABLE_AGENT_HOOK=false
# 서버 /stream에서 승인 필요 도구를 사용자 승인 없이 자동 허용할지 여부
# reject: 승인 필요 도구를 fail-closed 차단(권장) | allow: RBAC/모드 가시성 통과 시 자동 승인
THESEUS_SERVER_SENSITIVE_TOOL_POLICY=reject

# Remote Workspace 선택 시 remote_* 읽기 결과를 보고서 파일로 저장할지 여부
THESEUS_REMOTE_LOCAL_REPORT_WRITE_ENABLED=true
# local_write_report 저장 루트(Core worktree 내부 상대 경로)
THESEUS_LOCAL_REPORT_ROOT=reports
# true면 allowWriteExecution=false인 Remote Workspace에도 remote_write/edit_file을 노출합니다.
THESEUS_REMOTE_WORKSPACE_FILE_WRITE_OVERRIDE=false

# THESEUS_DEBUG_DUMP=true면 LLM 요청/응답을 JSON으로 덤프합니다(디버깅 전용, 대화 내용 저장됨).
THESEUS_DEBUG_DUMP=false
# THESEUS_DEBUG_DUMP_DIR=


# =======================================================
# 11. Custom Tool 전용 설정
# (생성 Tool 실행에 필요한 API 키나 설정값을 여기에 추가합니다)
# =======================================================
