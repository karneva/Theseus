# Core 이미지 빌드 컨텍스트에서 제외할 항목.
# 런타임에는 src/, theseus_engine/, requirements.txt(그리고 빌드용 scripts/provision_tool_rag_model.py)만 필요합니다.
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.git/
.dockerignore
Dockerfile
Dockerfile.sandbox
Dockerfile.sandbox.dockerignore

# 비밀값이 들어갈 수 있는 env 파일
.env
.env.*

# 서버 이미지에 필요 없는 소스·문서·테스트
vscode-extension/
docs/
scratch/
tests/
# scripts/는 빼되, 모델 스테이지가 쓰는 Tool RAG 모델 준비 스크립트만 넣습니다.
scripts/*
!scripts/provision_tool_rag_model.py
benchmarks/
theseus_cli/
theseus_cli.py
README.md
usage.md

# 런타임 데이터(볼륨으로 붙이는 경로)
theseus_engine/custom_tools/projects/*
theseus_engine/custom_tools/trash/
reports/
debug_dumps/
.theseus/
